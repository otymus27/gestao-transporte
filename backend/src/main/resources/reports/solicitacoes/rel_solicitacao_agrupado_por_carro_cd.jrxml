<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="solicitacoes_por_carro_sql" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c5f3c7b2-2f65-4b51-9aa8-4d9c7ddc2b12">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="conexao"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<query language="SQL"><![CDATA[
SELECT
    s.id                                       AS id,
    s.data_solicitacao                         AS data_solicitacao,

    -- carro (campo de agrupamento)
    CONCAT(c.placa, ' - ', c.marca, ' ', c.modelo) AS carro,

    m.nome                                     AS motorista,
    u.username                                 AS usuario,
    se.nome                                    AS setor,
    d.nome                                     AS destino,

    s.km_inicial                               AS km_inicial,
    s.km_final                                 AS km_final,

    -- km total numérico (pra somar)
    CASE
      WHEN s.km_inicial IS NULL OR s.km_final IS NULL THEN 0
      ELSE (s.km_final - s.km_inicial)
    END                                        AS km_total_num,

    -- km total texto (pra exibir "-" quando não tem)
    CASE
      WHEN s.km_inicial IS NULL OR s.km_final IS NULL THEN '-'
      ELSE CAST((s.km_final - s.km_inicial) AS CHAR)
    END                                        AS km_total_txt

FROM db_nutran.tb_solicitacao s
LEFT JOIN db_nutran.tb_carro c       ON c.id  = s.id_carro
LEFT JOIN db_nutran.tb_motorista m   ON m.id  = s.id_motorista
LEFT JOIN db_nutran.tb_usuarios u    ON u.id  = s.id_usuario
LEFT JOIN db_nutran.tb_setor se      ON se.id = s.id_setor
LEFT JOIN db_nutran.tb_destino d     ON d.id  = s.id_destino

ORDER BY carro ASC, s.data_solicitacao ASC, s.id ASC
]]></query>
	<field name="id" class="java.lang.Long"/>
	<field name="data_solicitacao" class="java.sql.Date"/>
	<field name="carro" class="java.lang.String"/>
	<field name="motorista" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<field name="setor" class="java.lang.String"/>
	<field name="destino" class="java.lang.String"/>
	<field name="km_inicial" class="java.lang.Integer"/>
	<field name="km_final" class="java.lang.Integer"/>
	<field name="km_total_num" class="java.lang.Integer"/>
	<field name="km_total_txt" class="java.lang.String"/>
	<variable name="TOTAL_SOLICITACOES" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{id}]]></expression>
	</variable>
	<variable name="KM_TOTAL_CARRO" resetType="Group" calculation="Sum" resetGroup="grpCarro" class="java.lang.Integer">
		<expression><![CDATA[$F{km_total_num} == null ? 0 : $F{km_total_num}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="KM_TOTAL_GERAL" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{km_total_num} == null ? 0 : $F{km_total_num}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
