		<expression><![CDATA[$F{km_total_num} == null ? 0 : $F{km_total_num}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="KM_TOTAL_GERAL" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{km_total_num} == null ? 0 : $F{km_total_num}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
